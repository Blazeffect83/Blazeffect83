# AEGIS configuration. Copy to /etc/aegis/aegis.env (installed service) or ./.env (development).
# Permissions: chmod 640, owner root:aegis. Never commit the real file.
# Every key can also be given as an environment variable, optionally prefixed AEGIS_.

# ---- Paths ---------------------------------------------------------------
DATA_DIR=/var/lib/aegis
# WORKSPACE_DIR=/var/lib/aegis/workspace
# BACKUP_DIR=/var/lib/aegis/backups
# LOG_DIR=/var/lib/aegis/logs

# ---- Dashboard / API -------------------------------------------------------
BIND_HOST=127.0.0.1          # keep loopback; reach it from the iPad via Tailscale/WireGuard (docs/INSTALL.md)
BIND_PORT=8600
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=         # set with: sudo -u aegis aegis --env-file /etc/aegis/aegis.env set-password
SESSION_SECRET=              # generated by set-password
API_TOKEN_HASH=              # optional: aegis create-token
COOKIE_SECURE=false          # true when served over HTTPS (Tailscale Serve / reverse proxy)
SESSION_TTL_HOURS=12
ALLOWED_HOSTS=*              # e.g. 127.0.0.1,localhost,aegis.tailnet-name.ts.net

# ---- Model provider ----------------------------------------------------------
# anthropic | openai | local | none.  "none" = research objectives with explicit URLs only.
MODEL_PROVIDER=none
# Model identifiers change. Pick one from the provider's CURRENT model list:
#   Anthropic: https://docs.anthropic.com/en/docs/about-claude/models
#   OpenAI:    https://platform.openai.com/docs/models
#   Local:     the model name your server reports (e.g. `ollama list`)
MODEL_NAME=
MODEL_NAME_LIGHT=            # optional cheaper model for extraction/classification roles
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_MODEL_BASE_URL=        # OpenAI-compatible endpoint, e.g. http://127.0.0.1:11434/v1 (Ollama) or :8080/v1 (llama.cpp)
LOCAL_ONLY=false             # true = paid providers disabled entirely
FALLBACK_PROVIDER=none       # only an explicitly named provider is ever used as fallback
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=3

# ---- Budgets (hard stops) ------------------------------------------------------
DAILY_SPEND_LIMIT_USD=2.00
SPEND_WARNING_FRACTION=0.8
RESEARCH_DAILY_SPEND_LIMIT_USD=0.50
MAX_TOKENS_PER_OBJECTIVE=200000
MAX_REQUESTS_PER_HOUR=120
# Prices per million tokens "model=input:output" (comma separated). Unknown models are
# charged at a conservative placeholder so limits still bite; costs are labelled estimates.
MODEL_PRICES=

# ---- Agent -----------------------------------------------------------------------
MAX_STEPS_PER_OBJECTIVE=40
MAX_REPLANS=4
MAX_STEP_ATTEMPTS=3
OBJECTIVE_TIME_BUDGET_MINUTES=120
CONCURRENT_OBJECTIVES=1
APPROVAL_TTL_MINUTES=60

# ---- Sandbox -----------------------------------------------------------------------
SANDBOX_BACKEND=auto         # auto | bwrap | rlimit | disabled
SANDBOX_ALLOW_WEAK=false     # never set true on a machine holding anything you care about
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=512
SANDBOX_MAX_PROCESSES=64
SANDBOX_MAX_FILE_MB=50
PACKAGE_INDEX_URL=https://pypi.org/simple

# ---- Research ------------------------------------------------------------------------
RESEARCH_ENABLED=true
RESEARCH_ALLOWED_DOMAINS=    # empty = any public domain (topics can narrow further)
RESEARCH_BLOCKED_DOMAINS=
RESEARCH_MAX_BYTES=3000000
RESEARCH_PER_DOMAIN_DELAY_SECONDS=2
SEARXNG_URL=                 # optional self-hosted SearXNG, e.g. http://127.0.0.1:8888
RESEARCH_USE_MODEL_EXTRACTION=false

# ---- Resource guard (pauses expensive work) --------------------------------------------
MAX_CPU_TEMP_C=78
MIN_FREE_DISK_MB=2048
MAX_MEMORY_PERCENT=90
MAX_LOAD_PER_CPU=2.5

# ---- Operations ---------------------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
LOG_MAX_MB=10
LOG_BACKUPS=5
METRICS_INTERVAL_SECONDS=60
APPROVED_SERVICES=           # e.g. nginx,ollama  (service_status / service_restart)
APPROVED_LOG_FILES=          # e.g. /var/log/syslog
APPROVED_CONTAINERS=

# ---- Notifications (optional) ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
