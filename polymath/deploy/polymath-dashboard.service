# Polymath dashboard (read-only web UI on port 8765). Installed by install.sh.
[Unit]
Description=Polymath dashboard
Documentation=file:///opt/polymath/src/docs/OPERATIONS.md
After=network.target local-fs.target
RequiresMountsFor=/srv/polymath

[Service]
Type=simple
User=polymath
Group=polymath
Environment=POLYMATH_CONFIG=/etc/polymath/polymath.toml
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/polymath/venv/bin/polymath dashboard
Restart=always
RestartSec=5
CPUQuota=25%
MemoryMax=400M
Nice=15

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# The database is opened read-only; SQLite's WAL index (-shm) still needs a writable directory.
ReadOnlyPaths=/srv/polymath -/mnt/polymath
ReadWritePaths=/srv/polymath/db

[Install]
WantedBy=multi-user.target
