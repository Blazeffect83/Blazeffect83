#!/bin/sh
# /usr/local/bin/polymath — the Polymath command for everyone on this machine.
# The agent's data belongs to the `polymath` user, so commands run as that user (through sudo when needed).
# `feed` and `--help` run as you (the feed reads from the dashboard); `storage attach|detach|eject` need root.
POLYMATH="${POLYMATH_BIN:-/opt/polymath/venv/bin/polymath}"
export POLYMATH_CONFIG="${POLYMATH_CONFIG:-/etc/polymath/polymath.toml}"
case "${1:-}" in
    feed|""|-h|--help|--version) exec "$POLYMATH" "$@" ;;
esac
if [ "$(id -u)" = 0 ]; then
    case "${1:-} ${2:-}" in
        "storage attach"|"storage detach"|"storage eject") exec "$POLYMATH" "$@" ;;
    esac
    exec runuser -u polymath -- "$POLYMATH" "$@"
fi
if [ "$(id -un)" = polymath ]; then
    exec "$POLYMATH" "$@"
fi
case "${1:-} ${2:-}" in
    "storage attach"|"storage detach"|"storage eject") exec sudo "$POLYMATH" "$@" ;;
esac
exec sudo -u polymath --preserve-env=POLYMATH_CONFIG "$POLYMATH" "$@"
